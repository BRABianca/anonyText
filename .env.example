# Exemplo de arquivo .env - Nunca commit valores reais!
# Copie este arquivo para .env e preencha com seus valores

# Banco de Dados PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/anonytext

# Textbelt API (SMS)
TEXTBELT_API_KEY=your_textbelt_api_key_here
TEXTBELT_API_KEY_TEST=your_textbelt_test_key_here
TEXTBELT_REPLY_WEBHOOK_URL=https://seu-dominio.com/sms/reply
TEXTBELT_REPLY_WEBHOOK_URL_TEST=https://seu-dominio-teste.com/sms/reply

# Autenticação
SMS_AUTH_SECRET=seu_jwt_secret_criptograficamente_seguro_aqui
SMS_LOGIN_PASSWORD_HASH=hash_scrypt_gerado_com_bcrypt_ou_scrypt
SMS_LOGIN_PASSWORD_SALT=salt_usado_no_hash

# CORS (Origins permitidas)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://seu-dominio.com
SMS_SEND_ALLOWED_ORIGINS=https://seu-dominio.com

# Configurações da Aplicação
NODE_ENV=production
PORT=3000

# URLs Base
APP_BASE_URL=https://seu-dominio.com
PUBLIC_BASE_URL=https://seu-dominio.com
REPLY_LINK_BASE_URL=https://seu-dominio.com
